{
    "manifest_version": 3,
    "name": "PDF Link Opener for the EP",
    "version": "1.2.11",
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "description": "An extension to open or download all Amendments of a European Parliament Report in a PDF file.",
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    },
    "permissions": ["activeTab", "storage"],
    "host_permissions": ["https://www.europarl.europa.eu/*"],
    "content_scripts": [
      {
        "matches": [
          "https://www.europarl.europa.eu/doceo/document/*_*.html",
          "https://www.europarl.europa.eu/doceo/document/*.html",
          "https://www.europarl.europa.eu/doceo/*/document/*_*.html",
          "https://www.europarl.europa.eu/doceo/*/document/*.html"
        ],
        "js": ["content-script.js"],
        "run_at": "document_idle",
        "all_frames": true
      }
    ]
  }